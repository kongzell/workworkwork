# คัดลอกเป็น .env แล้วแก้ค่าตามต้องการ:  cp .env.example .env
# docker compose อ่านไฟล์ .env ที่ root โดยอัตโนมัติ

# --- Postgres ---
POSTGRES_USER=followup
POSTGRES_PASSWORD=followup
POSTGRES_DB=followup
# เครื่องนี้มี PostgreSQL ติดตั้งอยู่แล้วและยึด 5432/5433 ไว้ — container เลยใช้ 55432
DB_PORT=55432

# --- พอร์ตที่เปิดออกมาที่ host ---
API_PORT=3000
WEB_PORT=8081          # 8080 ถูก Apache จองอยู่ / โหมด dev ใช้เป็นพอร์ตของ vite (แนะนำ 5173)

# --- backend ---
# origin ที่อนุญาตให้เรียก API (คั่นหลายค่าด้วย ,)
CORS_ORIGIN=http://localhost:8081

# --- Gemini (ใช้แตกงานย่อยด้วย AI) ---
# ขอ key ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ตั้งเป็น true เพื่อลอง UI ด้วยข้อมูลตัวอย่างโดยยังไม่ต้องมี key
AI_MOCK=false

# --- GitHub OAuth (login) ---
# สร้าง OAuth App ที่ https://github.com/settings/developers
# Authorization callback URL ต้องตรงกับ GITHUB_CALLBACK_URL เป๊ะ ๆ
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8081/api/auth/github/callback
# repo ที่จะดึง commit มาแสดง เช่น owner/repo (ต้อง push ขึ้น GitHub ก่อน)
GITHUB_REPO=
# secret ที่ตั้งตอนสร้าง webhook บน GitHub
GITHUB_WEBHOOK_SECRET=

# --- session ---
# ตอน deploy จริงเปลี่ยนเป็นค่าสุ่มยาว ๆ
SESSION_SECRET=dev-secret-change-me
# true = เปิด /api/auth/dev-login ไว้ทดสอบโดยไม่ต้องมี OAuth App
AUTH_MOCK=true
